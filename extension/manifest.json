{
  "manifest_version": 3,
  "name": "Playlist Predator - YouTube Sync",
  "version": "1.0.1",
  "description": "Auto-sync your YouTube watch progress to your currently active playlist in Playlist Predator.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Playlist Predator Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://playlist-predator.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playlist-predator.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["predator-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["youtube-tracker.js"],
      "css": ["youtube-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
